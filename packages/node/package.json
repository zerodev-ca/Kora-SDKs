{
    "name": "@zerodev-ca/kora",
    "version": "2.1.0",
    "description": "Official Node.js and TypeScript SDK for Kora licensing",
    "type": "module",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/zerodev-ca/Kora-SDKs.git",
        "directory": "packages/node"
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "files": [
        "dist"
    ],
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "scripts": {
        "build": "tsc",
        "typecheck": "tsc --noEmit"
    },
    "publishConfig": {
        "access": "public"
    },
    "devDependencies": {
        "@types/node": "^22.0.0",
        "typescript": "^5.6.0"
    }
}
